# Administrateur unique LearnFlow — un seul compte, pas d'inscription.
# Mot de passe long et unique (ne jamais committer .env.local).
ADMIN_EMAIL=admin@learnflow.tg
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=change-me-en-production-32-caracteres-min

# Optionnel : même projet Supabase que le web et le mobile (élèves + activité live)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement — ne jamais préfixer NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# IA (Prof, schémas, Super Prof) — Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MAX_TOKENS=8192

# App élève (lien dans les mails de relance)
LEARNFLOW_WEB_URL=http://localhost:3002

# Mails de relance (même SMTP / Resend que learnflow-web)
RESEND_API_KEY=
RESEND_FROM=LearnFlow <noreply@learnflow.tg>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LearnFlow <ton.gmail@gmail.com>
# INACTIVITY_DAYS=7

# WhatsApp parents (accueil + point de progression)
# Pas besoin d’API payante : l’admin envoie via wa.me depuis son téléphone.
# Twilio / Meta Cloud restent optionnels si tu veux l’envoi automatique plus tard.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+228xxxxxxxx
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=fr
# PARENT_NOTIFY_WEBHOOK_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3001
